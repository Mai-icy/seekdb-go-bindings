 /* ===================================================== Process ====== */
 
+#if defined(__linux__) && !defined(POSIX_SPAWN_SETSID)
+/* glibc before 2.26 lacks POSIX_SPAWN_SETSID. Keep the server in a new
+ * session and report exec failures to the parent through a close-on-exec
+ * pipe. The child uses only async-signal-safe calls between fork and exec. */
+static int spawn_process_with_fork(const char *bin_path, char *const argv[], Process *process)
+{
+    int error_pipe[2];
+    if (pipe2(error_pipe, O_CLOEXEC) != 0)
+        return ERR;
+    if (error_pipe[1] <= STDERR_FILENO) {
+        int write_fd = fcntl(error_pipe[1], F_DUPFD_CLOEXEC, STDERR_FILENO + 1);
+        if (write_fd < 0) {
+            close(error_pipe[0]);
+            close(error_pipe[1]);
+            return ERR;
+        }
+        close(error_pipe[1]);
+        error_pipe[1] = write_fd;
+    }
+
+    pid_t pid = fork();
+    if (pid < 0) {
+        close(error_pipe[0]);
+        close(error_pipe[1]);
+        return ERR;
+    }
+    if (pid == 0) {
+        close(error_pipe[0]);
+        if (setsid() < 0)
+            goto child_error;
+        int null_fd = open("/dev/null", O_RDWR);
+        if (null_fd < 0)
+            goto child_error;
+        if (dup2(null_fd, STDIN_FILENO) < 0 || dup2(null_fd, STDOUT_FILENO) < 0 ||
+            dup2(null_fd, STDERR_FILENO) < 0)
+            goto child_error;
+        if (null_fd > STDERR_FILENO)
+            close(null_fd);
+        execve(bin_path, argv, environ);
+
+    child_error: {
+        int saved_errno = errno;
+        while (write(error_pipe[1], &saved_errno, sizeof(saved_errno)) < 0 && errno == EINTR) {
+        }
+        _exit(127);
+    }
+    }
+
+    close(error_pipe[1]);
+    int child_errno = 0;
+    ssize_t received;
+    do {
+        received = read(error_pipe[0], &child_errno, sizeof(child_errno));
+    } while (received < 0 && errno == EINTR);
+    int read_errno = errno;
+    close(error_pipe[0]);
+    if (received != 0) {
+        if (received < 0) {
+            kill(pid, SIGKILL);
+            child_errno = read_errno;
+        }
+        while (waitpid(pid, NULL, 0) < 0 && errno == EINTR) {
+        }
+        errno = child_errno;
+        return ERR;
+    }
+    process->pid = (int64_t)pid;
+    return OK;
+}
+#endif
+
 int spawn_process(const char *bin_path, char *const argv[], Process **out_proc)
 {
     if (!bin_path || !argv || !out_proc) {
@@ -385,6 +456,17 @@ int spawn_process(const char *bin_path, char *const argv[], Process **out_proc)
 
